<?php
  // 引入基础配置文件
  include "/usr/local/emhttp/plugins/filebrowser_quantum/base.php";

  /*
   * 内外网分流（适配反向代理）
   * ---------------------------------------------------------------------------
   * 旧实现的问题：protocol 硬编码为 http://，host 只取 HTTP_HOST（忽略反代头），
   * 端口固定用 FileBrowser 的内网端口。在 https 域名反代 + externalUrl 留空时，
   * 会拼出 http://<外网域名>:<内网端口> —— 既指向了错误端口，又因父页面是 https
   * 被浏览器按 mixed content 直接拦截，于是 FB 标签页「无法访问」。
   *
   * 现在由 base.php 的 getFileBrowserNav() 统一解析：
   *   1) 内网访问 + http.internalUrl  → 用 internalUrl
   *   2) 外网访问 + http.externalUrl  → 用 externalUrl
   *   3) 否则按 X-Forwarded-Proto / X-Forwarded-Host / X-Forwarded-Port 推导，
   *      内网走「当前页面协议 + 内网主机 + FB 端口」，外网走「反代协议 + 反代域名 + 反代端口」
   */
  $fb = getFileBrowserNav();
  $pageScheme = getRequestScheme();
  $fbMixed = isMixedContentUrl($fb['url'], $pageScheme);
  $fbDebug = isset($_GET['fbdebug']) && $_GET['fbdebug'] !== '' && $_GET['fbdebug'] !== '0';
?>

